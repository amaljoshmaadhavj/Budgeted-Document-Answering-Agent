# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment variables & secrets (CRITICAL: Never commit .env or secrets)
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing & Cache
.pytest_cache/
.coverage
htmlcov/

# Logs & Traces
traces/*.json
traces/*.jsonl
!traces/.gitkeep

# Application temporary uploads & local settings
uploaded_docs/
.streamlit/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Operating System files
Thumbs.db
.DS_Store
